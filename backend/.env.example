# API Keys
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Model Configurations
# Verified Groq models (2026-08-17): openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.6-27b, allam-2-7b
# NOTE: `llama-3.1-8b-instant` no longer exists on Groq (HTTP 404).
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=nomic-embed-text

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Retry Configuration
MAX_RETRIES=2
RETRY_DELAY=1

# Guardrails
# ALLOW_PYTHON_EXEC: off by default. The Python executor is not a real sandbox;
# enabling it executes arbitrary Python with full builtins in-process.
ALLOW_PYTHON_EXEC=false
MAX_AGENT_ITERATIONS=6
MAX_TOOL_CALLS=50
TOOL_TIMEOUT_SECONDS=15.0

# Observability / retention
MAX_WORKFLOW_STATE_ENTRIES=500

# Logging
LOG_LEVEL=INFO
